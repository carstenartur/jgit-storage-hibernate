{
  "schemaVersion": 1,
  "updated": "2026-08-08",
  "policy": {
    "candidateSource": "same-job local Maven install",
    "remoteSnapshots": false,
    "pullRequestMode": "bounded consumer-specific smoke tests",
    "releaseMode": "all applicable consumer and database contracts must pass"
  },
  "consumers": [
    {
      "id": "audio-analyzer",
      "repository": "carstenartur/audio-analyzer",
      "ref": "72b31843faa40ea73d95ad104ea29c7b22aa10f9",
      "defaultBranch": "master",
      "upstreamModules": [
        "jgit-storage-hibernate-core",
        "jgit-storage-hibernate-search"
      ],
      "contract": [
        "entity-returning GitHistorySearchService API remains compatible",
        "changed-path values remain available for workflow-history results",
        "best-effort incremental indexing does not affect authoritative Git history",
        "bounded branch rebuild and candidate-object filtering compile and test",
        "H2 and PostgreSQL persistence/search dependency alignment"
      ],
      "smokeCommand": "mvn -B -f consumer/pom.xml -pl audio-app -am test -Djgit-storage-hibernate.version=${candidate.version}"
    },
    {
      "id": "taxonomy",
      "repository": "carstenartur/Taxonomy",
      "ref": "d2c1f5d53f45c8e2d51c3a6bbcaf5cc9bb2d847c",
      "defaultBranch": "main",
      "upstreamModules": [
        "jgit-storage-hibernate-core"
      ],
      "contract": [
        "fail-closed exact Core schema classification remains intentional",
        "Core migrations precede Hibernate validation",
        "HSQLDB and PostgreSQL migration/index/startup contracts pass",
        "SQL Server and Oracle remain explicit scheduled or coordinated contracts",
        "Taxonomy's separate Hibernate Search domain remains independent"
      ],
      "smokeCommand": "./mvnw -B -pl taxonomy-app -am test -Djgit-storage-hibernate.version=${candidate.version} -Dtest=JgitStorageHibernateIntegrationTest,JgitStorageOptimizedIndexContractTest,JgitStorageSchemaIndexValidationTest,JgitStorageSchemaMigrationConfigTest -Dsurefire.failIfNoSpecifiedTests=false"
    },
    {
      "id": "sandbox",
      "repository": "carstenartur/sandbox",
      "ref": "6eec161d5bb224e90257773f5ecc7af4e0592359",
      "defaultBranch": "main",
      "upstreamModules": [
        "jgit-storage-hibernate-core"
      ],
      "contract": [
        "OSGi bridge and shaded standalone server link against public Core APIs",
        "repository lifecycle and deletion serialization remain compatible",
        "read-only legacy preflight remains available",
        "H2 smoke and SQL Server adoption contracts stay explicit",
        "copied Search and Java-analysis migration is not falsely treated as complete"
      ],
      "smokeCommand": "mvn -B -f consumer/sandbox-jgit-storage-hibernate/pom.xml install -Djgit-storage-hibernate.version=${candidate.version} && mvn -B -f consumer/sandbox-jgit-server-webapp/pom.xml package -Djgit-storage-hibernate.version=${candidate.version}"
    }
  ]
}
