+package io.github.carstenartur.jgit.storage.hibernate.security;
+
+import java.time.Instant;
+import java.util.Objects;
+import java.util.regex.Pattern;
+
+/** Secret-free issuer and revocation provenance for one access token. */
+public record AccessTokenLifecycleProvenance(
+    String tokenId,
+    String principalId,
+    Instant issuedAt,
+    String issuedByPrincipalId,
+    Instant revokedAt,
+    String revokedByPrincipalId,
+    String revocationReasonCode,
+    long securityVersion) {
+
+  private static final Pattern REASON_CODE = Pattern.compile("[A-Z][A-Z0-9_]{0,127}");
+
+  /** Validate bounded stable identifiers without accepting credential material. */
+  public AccessTokenLifecycleProvenance {
+    tokenId = required("tokenId", tokenId, 128);
+    principalId = required("principalId", principalId, 128);
+    issuedAt = Objects.requireNonNull(issuedAt, "issuedAt");
+    issuedByPrincipalId = required("issuedByPrincipalId", issuedByPrincipalId, 128);
+    if (revokedAt == null) {
+      if (revokedByPrincipalId != null || revocationReasonCode != null) {
+        throw new IllegalArgumentException(
+            "revocation actor and reason require a revokedAt timestamp");
+      }
+    } else {
+      if (revokedAt.isBefore(issuedAt)) {
+        throw new IllegalArgumentException("revokedAt must not be before issuedAt");
+      }
+      if (revokedByPrincipalId != null) {
+        revokedByPrincipalId = required("revokedByPrincipalId", revokedByPrincipalId, 128);
+      }
+      if (revocationReasonCode != null
+          && !REASON_CODE.matcher(revocationReasonCode).matches()) {
+        throw new IllegalArgumentException(
+            "revocationReasonCode must be an uppercase bounded reason code");
+      }
+    }
+    if (securityVersion < 1) {
+      throw new IllegalArgumentException("securityVersion must be positive");
+    }
+  }
+
+  /** Return whether the token has been revoked. */
+  public boolean revoked() {
+    return revokedAt != null;
+  }
+
+  /** Return whether a legacy revoked row has incomplete trustworthy evidence. */
+  public boolean incompleteLegacyRevocationEvidence() {
+    return revokedAt != null
+        && (revokedByPrincipalId == null || revocationReasonCode == null);
+  }
+
+  static String validatedReasonCode(String value) {
+    String reason = required("revocationReasonCode", value, 128);
+    if (!REASON_CODE.matcher(reason).matches()) {
+      throw new IllegalArgumentException(
+          "revocationReasonCode must be an uppercase bounded reason code");
+    }
+    return reason;
+  }
+
+  private static String required(String name, String value, int maximumLength) {
+    if (value == null || value.isBlank()) {
+      throw new IllegalArgumentException(name + " must not be blank");
+    }
+    if (value.length() > maximumLength) {
+      throw new IllegalArgumentException(
+          name + " must contain at most " + maximumLength + " characters");
+    }
+    if (!value.equals(value.strip()) || value.chars().anyMatch(Character::isISOControl)) {
+      throw new IllegalArgumentException(
+          name + " must not contain surrounding whitespace or control characters");
+    }
+    return value;
+  }
+}
