+package io.github.carstenartur.jgit.storage.hibernate;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import io.github.carstenartur.jgit.storage.hibernate.config.HibernateSessionFactoryProvider;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Properties;
+import java.util.Random;
+import org.eclipse.jgit.internal.storage.dfs.DfsBlockCache;
+import org.eclipse.jgit.internal.storage.dfs.DfsBlockCacheConfig;
+import org.eclipse.jgit.lib.CommitBuilder;
+import org.eclipse.jgit.lib.Constants;
+import org.eclipse.jgit.lib.FileMode;
+import org.eclipse.jgit.lib.ObjectId;
+import org.eclipse.jgit.lib.PersonIdent;
+import org.eclipse.jgit.lib.RefUpdate;
+import org.eclipse.jgit.lib.TreeFormatter;
+import org.junit.jupiter.api.Test;
+
+class PackStreamLargeH2Test {
+  @Test
+  void transferredLargePackSurvivesSourceDeletionAndColdReopen() throws Exception {
+    byte[] data = new byte[20 * 1024 * 1024 + 257];
+    new Random(184).nextBytes(data);
+    String expectedHash = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(data));
+    Properties properties = new Properties();
+    properties.put("hibernate.connection.url", "jdbc:h2:mem:bulk-pack-large");
+    properties.put("hibernate.connection.driver_class", "org.h2.Driver");
+    properties.put("hibernate.hbm2ddl.auto", "create-drop");
+    try (var provider = new HibernateSessionFactoryProvider(properties)) {
+      var factory = new DefaultHibernateRepositoryFactory(provider.getSessionFactory());
+      var sourceName = new RepositoryName("source");
+      var targetName = new RepositoryName("target");
+      ObjectId blob;
+      ObjectId commitId;
+      try (var source = factory.open(sourceName); var inserter = source.repository().newObjectInserter()) {
+        blob = inserter.insert(Constants.OBJ_BLOB, data);
+        TreeFormatter tree = new TreeFormatter();
+        tree.append("payload.bin", FileMode.REGULAR_FILE, blob);
+        CommitBuilder commit = new CommitBuilder();
+        commit.setTreeId(inserter.insert(tree));
+        PersonIdent author = new PersonIdent("Transfer spike", "transfer@example.invalid");
+        commit.setAuthor(author);
+        commit.setCommitter(author);
+        commit.setMessage("bounded pack transfer");
+        commitId = inserter.insert(commit);
+        inserter.flush();
+        RefUpdate update = source.repository().updateRef("refs/heads/main");
+        update.setExpectedOldObjectId(ObjectId.zeroId());
+        update.setNewObjectId(commitId);
+        assertEquals(RefUpdate.Result.NEW, update.update());
+      }
+      var result = factory.transfer(RepositoryTransferRequest.initialClone(
+          sourceName, targetName, List.of(new RefTransferSpec("refs/heads/main", "refs/heads/main"))));
+      assertEquals(3, result.objectsTransferred());
+      assertTrue(result.bytesTransferred() >= data.length);
+      assertEquals(commitId, result.refs().get("refs/heads/main").targetObjectId());
+      assertTrue(factory.deleteRepository(sourceName).deletedAnything());
+
+      DfsBlockCache.reconfigure(new DfsBlockCacheConfig());
+      try (var target = factory.open(targetName);
+          var stream = target.repository().open(blob).openStream()) {
+        var digest = MessageDigest.getInstance("SHA-256");
+        byte[] buffer = new byte[64 * 1024];
+        for (int n; (n = stream.read(buffer)) != -1; ) {
+          digest.update(buffer, 0, n);
+        }
+        assertEquals(expectedHash, HexFormat.of().formatHex(digest.digest()));
+        assertEquals(commitId, target.repository().exactRef("refs/heads/main").getObjectId());
+      }
+    }
+  }
+}
