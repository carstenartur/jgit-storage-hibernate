        <artifactId>jgit-storage-hibernate-search</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>jgit-storage-hibernate-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>jgit-storage-hibernate-spring-boot-starter</artifactId>
        <version>${project.version}</version>
