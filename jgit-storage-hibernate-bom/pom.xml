    <artifactId>jgit-storage-hibernate-parent</artifactId>
    <version>0.11.3-SNAPSHOT</version>
  </parent>

  <artifactId>jgit-storage-hibernate-bom</artifactId>
  <packaging>pom</packaging>
  <name>jgit-storage-hibernate Consumer BOM</name>
  <description>
