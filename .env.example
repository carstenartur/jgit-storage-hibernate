# Copy this file to .env, set strong values, and keep .env out of version control.
JSH_DATABASE_PASSWORD=
JSH_ADMIN_USERNAME=admin
JSH_ADMIN_PASSWORD=

# Safe local default. Set 0.0.0.0 only behind a firewall and TLS reverse proxy.
JSH_BIND_ADDRESS=127.0.0.1
JSH_PORT=8080

# Keep NONE/false for direct localhost HTTP. Behind a trusted TLS reverse proxy,
# set FRAMEWORK/true and prevent clients from reaching the container directly.
JSH_FORWARD_HEADERS_STRATEGY=NONE
JSH_REQUIRE_SECURE_TRANSPORT=false

# Actuator metrics are intentionally opt-in because management endpoints are public.
JSH_MANAGEMENT_ENDPOINTS=health,info
