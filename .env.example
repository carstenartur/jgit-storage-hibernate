# Copy this file to .env, set strong values, and keep .env out of version control.
JSH_DATABASE_PASSWORD=
JSH_ADMIN_USERNAME=admin
JSH_ADMIN_PASSWORD=

# Safe local default. Set 0.0.0.0 only behind a firewall and TLS reverse proxy.
JSH_BIND_ADDRESS=127.0.0.1
JSH_PORT=8080

# Keep false for direct localhost HTTP. Behind a trusted TLS reverse proxy,
# prevent clients from reaching the container directly and enable secure transport.
JSH_REQUIRE_SECURE_TRANSPORT=false

# The following two settings are supported by current source and images 0.11.3+.
# Released image 0.11.2 ignores them and exposes health, info and metrics.
JSH_FORWARD_HEADERS_STRATEGY=NONE
JSH_MANAGEMENT_ENDPOINTS=health,info
